{   
    "explorer.compactFolders": false,
    "editor.minimap.enabled": false,
    "files.autoSave": "afterDelay",
    "workbench.colorTheme": "OM Theme (No Italic)",
    "editor.renderWhitespace": "all",
    "editor.insertSpaces": true,
    "breadcrumbs.enabled": false,
    "editor.stickyScroll.enabled": false,
    "[html]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.suggest.insertMode": "replace"
    },
    "hediet.vscode-drawio.resizeImages": null,
    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.donotShowInfoMsg": true,
    "workbench.iconTheme": "vs-seti",
    "emmet.triggerExpansionOnTab": true,
    "emmet.showExpandedAbbreviation": "always",
    "diffEditor.renderSideBySide": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "workbench.browser.openLocalhostLinks": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.enablePreview": true,
    "editor.rulers": [
        79,
        120,
    ],
    "workbench.editor.labelFormat": "short",

    
    "workbench.startupEditor": "newUntitledFile",
    "window.zoomLevel": 0,
    "jjs/ts.preferences.quoteStyle": "single",
    "tjs/ts.preferences.quoteStyle": "single",
    "js/ts.validate.enabled": false,
    "emmet.syntaxProfiles": {
        "javascript": "jsx"
    },
    "emmet.includeLanguages": {
        "django-html": "html",
        "javascript": "javascriptreact"
    },
    "git.enableSmartCommit": true,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.shell.linux": "zsh",
    "terminal.integrated.fontFamily": "monospace",
    "terminal.integrated.fontSize": 14,
    "editor.fontSize": 14,
    "debug.console.fontSize": 14,
    "editor.fontFamily": "'Liga Droid Sans Mono'",
    "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
    },
    "js/ts.suggest.autoImports": true,
    "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
    ],
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },
    "editor.tabSize": 2,
    "editor.formatOnSave": false,
    "editor.fontLigatures": true,
    "editor.renderLineHighlight": "gutter",
    "bracketPairColorizer.showBracketsInGutter": true,
    "toggleFileEventLogging": true,
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.ignoreSelection": true,
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "python": "./venv/bin/python -u",
        "javascript": "node",
        "php": "php",
        "perl": "perl",
        "shellscript": "bash",
    },
    "files.associations": {
        "*.html": "html",
        "**/templates/*.html": "django-html",
        "**/templates/*": "django-txt",
        "**/requirements{/**,*}.{txt,in}": "pip-requirements"
    },
    "python.linting.pylintArgs": [
        "--load-plugins=pylint_django",
        "--errors-only",
    ],
    "python.pythonPath": "/usr/bin/python3",
    "js/ts.updateImportsOnFileMove.enabled": "never",

}